{#
 # Sidebar sections laid out like Twenty's navigation drawer.
 #
 # The platform template renders a section (Clients, Invoices...) as a dropdown toggle whose
 # children are "List" and "Add", so reaching the list costs two clicks and every row carries a
 # chevron. Here a section is one row instead:
 #   - the row links to the section's first child (the list);
 #   - an "add"/"create" child becomes a "+" button at the end of the row;
 #   - any other child (vendors, categories, settings pages...) is listed under the row, indented,
 #     only while the section holds the current page.
 # Leaf items and every other menu keep the platform rendering.
 #}
{% extends '@!SolidWorxPlatform/Menu/menu.html.twig' %}
{% import 'knp_menu.html.twig' as ui %}

{% block item %}
    {% if item.displayed and item.parent.isRoot and item.hasChildren and item.displayChildren and options.ws_sections|default(false) %}
        {%- set visible = item.children|filter(c => c.displayed) -%}
        {%- set linked = visible|filter(c => c.uri is not empty) -%}
        {#- The System section's natural landing page is Settings, not its first entry. -#}
        {%- set primary = linked|filter(c => c.extras.routes[0].route|default('') == '_settings')|first ?: linked|first -%}
        {%- set add = null -%}
        {%- set others = [] -%}
        {%- for child in visible -%}
            {%- set route = child.extras.routes[0].route|default('') -%}
            {%- if child is not same as(primary) -%}
                {%- if add is null and (route ends with '_add' or route ends with '_create' or '_create_' in route) -%}
                    {%- set add = child -%}
                {%- else -%}
                    {%- set others = others|merge([child]) -%}
                {%- endif -%}
            {%- endif -%}
        {%- endfor -%}
        {%- set open = matcher.isCurrent(item) or matcher.isAncestor(item, options.matchingDepth) -%}
        {%- set primaryCurrent = primary ? matcher.isCurrent(primary) : false -%}

        <li class="nav-item ws-section{{ open ? ' active' }}">
            <div class="ws-row{{ primaryCurrent or (open and others is empty) ? ' is-current' }}">
                <a href="{{ primary ? primary.uri : '#' }}" class="nav-link"{% if primaryCurrent %} aria-current="page"{% endif %}>
                    {% if item.extras.icon is defined %}
                        <span class="nav-link-icon">{{ ux_icon('tabler:' ~ item.extras.icon) }}</span>
                    {% endif %}
                    <span class="nav-link-title">{{ item.label|trans }}</span>
                </a>
                {% if add %}
                    <a href="{{ add.uri }}" class="ws-row-action" title="{{ add.label|trans }}" aria-label="{{ add.label|trans }}">
                        {{ ux_icon('tabler:plus') }}
                    </a>
                {% endif %}
            </div>
            {% if others is not empty and open %}
                <ul class="ws-sublist">
                    {% for child in others %}
                        <li>
                            <a href="{{ child.uri }}" class="ws-subitem{{ matcher.isCurrent(child) or matcher.isAncestor(child, options.matchingDepth) ? ' is-current' }}">
                                {{ child.label|trans }}
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </li>
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock %}
