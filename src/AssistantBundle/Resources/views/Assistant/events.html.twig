{% extends "@SolidInvoiceAssistant/Assistant/_layout.html.twig" %}

{% block assistant_content %}
    <p class="text-secondary mb-3">{{ ('assistant.' ~ view ~ '.intro')|trans({'%name%': assistant.name}) }}</p>
    <twig:Ui:Card>
        <twig:DataGrid name="assistant_event_grid" :context="{ assistant_id: (assistant.id ~ ''), view: view }" />
    </twig:Ui:Card>
{% endblock %}
