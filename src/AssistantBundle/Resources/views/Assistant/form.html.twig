{% extends "@SolidInvoiceCore/Layout/default.html.twig" %}

{% block content %}
<div class="form-page">
    {{ form_start(form) }}
    {{ form_errors(form) }}

    <div class="form-page-container form-page-container--narrow">
        <div class="form-page-header">
            <div class="form-page-header-content">
                <div class="form-page-icon">{{ ux_icon('tabler:robot', {width: 28, height: 28}) }}</div>
                <div>
                    <h1 class="form-page-title">{{ 'assistant.add'|trans }}</h1>
                    <p class="form-page-subtitle">{{ 'assistant.subtitle'|trans }}</p>
                </div>
            </div>
        </div>

        <div class="form-page-sections">
            <section class="form-page-section">
                <div class="section-content">
                    {% include '@SolidInvoiceAssistant/Assistant/_assistant_fields.html.twig' %}
                </div>
            </section>
        </div>

        {{ form_rest(form) }}

        <div class="form-page-actions">
            <div class="form-page-actions-inner">
                <a href="{{ path('_assistants') }}" class="btn btn-ghost">
                    {{ ux_icon('tabler:arrow-left', {width: 18, height: 18}) }} {{ 'action.cancel'|trans }}
                </a>
                <button type="submit" class="btn btn-primary btn-save">
                    {{ ux_icon('tabler:device-floppy', {width: 18, height: 18}) }} {{ 'action.save'|trans }}
                </button>
            </div>
        </div>
    </div>

    {{ form_end(form) }}
</div>
{% endblock %}
