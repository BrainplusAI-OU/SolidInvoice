{% extends '@SolidInvoiceCore/Layout/base.html.twig' %}

{% block navbar_actions %}
    {% include "@SolidInvoiceCore/Menu/search.html.twig" with {"title" : block('title') ?? '', "header_content" : header_content|default('')} %}
{% endblock navbar_actions %}

{% block user_menu %}
    {% include "@SolidInvoiceCore/Menu/top.html.twig" with {"title" : block('title') ?? '', "header_content" : header_content|default('')} %}
    {{ parent() }}
{% endblock user_menu %}

{% block user_menu_items %}
    <a href="{{ path('_profile') }}" class="dropdown-item">
        {{ ux_icon('tabler:user', {width: 16, height: 16}) }}
        {{ 'layout.profile'|trans }}
    </a>
    <div class="dropdown-divider"></div>
    <a href="{{ path('_api_keys_index') }}" class="dropdown-item">
        {{ ux_icon('tabler:lock', {width: 16, height: 16}) }}
        {{ 'layout.api_keys'|trans }}
    </a>
    <a href="{{ path('_export_list') }}" class="dropdown-item">
        {{ ux_icon('tabler:database-export', {width: 16, height: 16}) }}
        {{ 'layout.data_export'|trans }}
    </a>
    {% if not white_label() %}
    <a href="{{ feedback_form_url }}" class="dropdown-item" target="_blank" rel="noopener">
        {{ ux_icon('tabler:message-circle', {width: 16, height: 16}) }}
        {{ 'layout.feedback'|trans }}
    </a>
    {% endif %}
    <div class="dropdown-divider"></div>
    <twig:Ui:Security:LogoutLink />
{% endblock user_menu_items %}

{% block footer %}
    {% if white_label() %}
    <small>&copy; {{ 'now'|date('Y') }} {{ company_name() }}</small>
    {% else %}
    <small>{{ "layout.powered_by"|trans }} <a href="https://solidinvoice.co">{{ constant('SolidInvoice\\CoreBundle\\SolidInvoiceCoreBundle::APP_NAME') }}</a>{% if app_version %} - {{ app_version }}{% endif %} &middot; <a href="{{ feedback_form_url }}" target="_blank" rel="noopener">{{ 'layout.feedback'|trans }}</a>{% if affiliate_program().enabled %} &middot; <a href="{{ path('_profile_affiliate', {source: 'footer'}) }}" class="text-secondary">{{ 'affiliate.footer_link'|trans }}</a>{% endif %}</small>
    {% endif %}
{% endblock footer %}

{#
 # Navigation laid out like Twenty's drawer: a compact workspace row, a section label, one row
 # per section (see templates/bundles/SolidWorxPlatformBundle/Menu/menu.html.twig).
 #
 # Below the lg breakpoint the sidebar is a slim top bar (menu button, workspace, create, user)
 # and the navigation slides in from the left over the page, with a backdrop, instead of
 # unfolding inline and pushing the page down. Above it, the same drawer is the fixed sidebar.
 #}
{% block sidebar %}
    <aside class="navbar navbar-vertical navbar-expand-lg ws-sidebar">
        <div class="container-fluid">
            <div class="ws-mobile-bar d-lg-none">
                <button class="ws-icon-button" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebar-menu" aria-controls="sidebar-menu" aria-label="{{ 'layout.aria.open_navigation'|trans }}">
                    {{ ux_icon('tabler:menu-2', {width: 20, height: 20}) }}
                </button>
                <a href="{{ path('_dashboard') }}" class="ws-workspace ws-workspace--bar text-decoration-none">
                    <span class="ws-workspace-logo">{{ app_logo(showDefault: true) }}</span>
                    <span class="ws-workspace-name">{{ company_name() }}</span>
                </a>
                <div class="ws-mobile-actions navbar-nav flex-row">
                    {{ block('user_menu') }}
                </div>
            </div>

            <div class="offcanvas-lg offcanvas-start ws-drawer" tabindex="-1" id="sidebar-menu" aria-label="{{ company_name() }}">
                <div class="ws-drawer-head">
                    {{ block('sidebar_brand') }}
                    <button type="button" class="ws-icon-button d-lg-none" data-bs-dismiss="offcanvas" data-bs-target="#sidebar-menu" aria-label="{{ 'layout.aria.close_navigation'|trans }}">
                        {{ ux_icon('tabler:x', {width: 18, height: 18}) }}
                    </button>
                </div>

                {# Switching company lives in the drawer on phones; the top bar keeps create and the user. #}
                <div class="ws-drawer-switcher d-lg-none navbar-nav">
                    {% include '@SolidInvoiceCore/Menu/company_switcher.html.twig' %}
                    {{ block('workspace_switcher') }}
                </div>

                <div class="ws-drawer-body">
                    <div class="ws-section-label">{{ 'menu.workspace'|trans }}</div>
                    {% if menu_exists('sidebar') %}
                        {{ render_menu('sidebar', {ws_sections: true, root_class: 'navbar-nav'}) }}
                    {% endif %}
                    {{ block('sidebar_footer') }}
                </div>
            </div>
        </div>
    </aside>
{% endblock sidebar %}

{% block sidebar_brand %}
    {# Twenty's workspace row: a small square logo and the name on one line, truncated. #}
    <a href="{{ path('_dashboard') }}" class="ws-workspace text-decoration-none" title="{{ company_name() }}">
        <span class="ws-workspace-logo">{{ app_logo(showDefault: true) }}</span>
        <span class="ws-workspace-name">{{ company_name() }}</span>
    </a>
{% endblock sidebar_brand %}
