{# The brand above the signed-out pages' form: a white-label logo alone, otherwise the icon and the name. #}
{% if brand_logo_only() %}
    <span class="brand-logo-only d-inline-block bg-white rounded p-2 shadow-sm">
        {{ app_logo(220, showDefault: true, showOnlyAppIcon: true) }}
    </span>
{% else %}
    <span class="text-white h1">
        {{ app_logo(showDefault: true, showOnlyAppIcon: true) }} {{ app_name }}
    </span>
{% endif %}
