{# A custom photo behind the signed-out pages (SOLIDINVOICE_LOGIN_BACKGROUND), in place of login.scss's default. #}
{% set background = login_background() %}
{% if background %}
    <style>
        body .page {
            background-image: url("{{ background }}");
            background-size: cover;
            background-position: center;
        }
    </style>
{% endif %}
